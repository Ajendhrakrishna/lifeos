# Copy this file to .env and fill in the values. Never commit .env.
# All three stay on the server. The browser never receives any key.

# Supabase: Project Settings -> API Keys (Project URL)
SUPABASE_URL=
# Supabase: Project Settings -> API Keys -> secret key (sb_secret_...). Used by the server.
SUPABASE_SECRET_KEY=
# Supabase: Project Settings -> API Keys -> publishable key (sb_publishable_...).
# Only used by scripts/check-isolation.mjs to prove the RLS policies work.
SUPABASE_PUBLISHABLE_KEY=
